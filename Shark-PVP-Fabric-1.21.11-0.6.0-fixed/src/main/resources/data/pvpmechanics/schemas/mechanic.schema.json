{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PvP Mechanics Mechanic",
  "type": "object",
  "required": [
    "id",
    "name",
    "gamemodes",
    "icon",
    "difficulty",
    "enabled"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+\\.[a-z0-9_.]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "short_name": {
      "type": "string"
    },
    "gamemodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "icon": {
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced",
        "expert"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "order": {
      "type": "integer"
    },
    "description": {
      "type": "string"
    },
    "short_description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preview": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tips": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "common_mistakes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_mechanics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "training_scenario": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
